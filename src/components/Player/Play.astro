<link rel="stylesheet" href="/Play.css" />
<div class="container-play">
  <div class="top-play-component-actions">
    <button class="previous-action" aria-label="previous play">
      <img src="/previous.svg" width="15" alt="" srcset="" />
    </button>

    <button class="play-action" aria-label="play action">
      <img
        src="/iconPlay.svg"
        class="play-action-icon"
        data-action="stopped"
        width="15"
        alt=""
        srcset=""
      />
    </button>

    <button class="next-action" aria-label="next play">
      <img src="/next.svg" width="15" alt="" srcset="" />
    </button>
  </div>
  <div class="container-for-play-component">
    <span id="time-current">0:00</span>
    <div class="progress-container progress-bar-track" id="progress-container">
      <div class="progress-bar" id="progress-bar"></div>
      <div class="progress-knob" id="progress-knob"></div>
    </div>
    <span id="time-total">0:00</span>
  </div>
</div>

<script nonce={Astro.locals.nonce} type="module">
  let player;
  let duration = 0;
  let position = 0;
  let lastUpdate = 0;
  let isPlaying = false;
  let isDragging = false;

  const bar = document.getElementById("progress-bar");
  const knob = document.getElementById("progress-knob");
  const timeCurrent = document.getElementById("time-current");
  const timeTotal = document.getElementById("time-total");
  const container = document.getElementById("progress-container");

  function positionFromEvent(e) {
    const rect = container.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const percent = Math.min(Math.max(x / rect.width, 0), 1);
    return Math.floor(duration * percent);
  }

  async function commitSeek(ms) {
    position = ms;
    lastUpdate = Date.now();
    updateUI();
    if (window.__pendingResume) {
      window.__pendingResume.position = ms;
      return;
    }
    try {
      await spotifyPlayerAction("seek", {
        position_ms: ms,
        deviceId: window.deviceId,
      });
    } catch (err) {
      console.error("Error al hacer seek:", err);
    }
  }

  container.addEventListener("pointerdown", (e) => {
    if (!window.deviceId || !duration) return;
    isDragging = true;
    container.setPointerCapture?.(e.pointerId);
    position = positionFromEvent(e);
    updateUI();
  });

  container.addEventListener("pointermove", (e) => {
    if (!isDragging) return;
    position = positionFromEvent(e);
    updateUI();
  });

  container.addEventListener("pointerup", async (e) => {
    if (!isDragging) return;
    isDragging = false;
    container.releasePointerCapture?.(e.pointerId);
    await commitSeek(positionFromEvent(e));
  });

  container.addEventListener("pointercancel", () => {
    isDragging = false;
  });

  function msToTime(ms) {
    const m = Math.floor(ms / 60000);
    const s = Math.floor((ms % 60000) / 1000);
    return `${m}:${s.toString().padStart(2, "0")}`;
  }

  function updateUI() {
    const percent = position / duration;
    bar.style.transform = `scaleX(${percent})`;
    knob.style.transform = `translate(${percent * container.clientWidth}px, -50%)`;
    timeCurrent.textContent = msToTime(position);
    timeTotal.textContent = msToTime(duration);
  }

  function animate() {
    if (isPlaying && !isDragging) {
      const now = Date.now();
      position += now - lastUpdate;
      if (position > duration) position = duration;
      updateUI();
      lastUpdate = now;
    } else {
      lastUpdate = Date.now();
    }
    requestAnimationFrame(animate);
  }
  import { spotifyPlayerAction } from "/scripts/spotifyPlayerActions.js";
  import { localStorageGet } from "/scripts/localStorage.js";

  import { playerEvents } from "/scripts/playerEvents.js";
  import { goPrevious, goNext } from "/scripts/playHistory.js";

  const PlayIcon = "/iconPlay.svg";
  const previousElement = document.querySelector(".previous-action");
  previousElement?.addEventListener("click", async () => {
    const state = await window.player?.getCurrentState();
    if (state?.track_window?.previous_tracks?.length > 0) {
      window.__navInProgress = true;
      await window.player.previousTrack();
      return;
    }
    const prev = goPrevious();
    if (prev) {
      window.__navInProgress = true;
      await spotifyPlayerAction("play", {
        uris: [prev.uri],
        deviceId: window.deviceId,
      });
      return;
    }
    try {
      await spotifyPlayerAction("previous", { deviceId: window.deviceId });
    } catch (error) {}
  });

  const playElement = document.querySelector(".play-action");

  playElement?.addEventListener("click", async () => {
    const imgElement = document.querySelector(".play-action-icon");
    if (imgElement.dataset.action === "stopped") {
      imgElement.src = "/iconPause.svg";
      imgElement.dataset.action = "play";

      const state = await window.player?.getCurrentState();
      const pending = window.__pendingResume;
      if (pending && !state) {
        window.__pendingResume = null;
        await spotifyPlayerAction("play", {
          uris: [pending.uri],
          position_ms: pending.position,
          deviceId: window.deviceId,
        });
      } else if (state && state.track_window?.current_track) {
        await spotifyPlayerAction("play", { deviceId: window.deviceId });
      } else {
        const lastPlayed = localStorageGet("lastPlayedHistory");
        if (lastPlayed?.trackId) {
          await spotifyPlayerAction("play", {
            uris: [`spotify:track:${lastPlayed.trackId}`],
            deviceId: window.deviceId,
          });
        }
      }
      playerEvents.dispatchEvent(new Event("resume"));

      try {
        const toggleRestButton = localStorageGet("icon-play");
        const iconImageButton = document.querySelector(
          `.${toggleRestButton[0].className}`,
        );
        iconImageButton.src = "/pause.svg";
      } catch (error) {}
    } else if (imgElement.dataset.action === "play") {
      imgElement.src = PlayIcon;
      imgElement.dataset.action = "stopped";
      await spotifyPlayerAction("pause", { deviceId: window.deviceId });

      try {
        const toggleRestButton = localStorageGet("icon-play");
        const iconImageButton = document.querySelector(
          `.${toggleRestButton[0].className}`,
        );
        iconImageButton.src = "/play.svg";
      } catch (error) {}
      playerEvents.dispatchEvent(new Event("pause"));
    }
  });
  playerEvents.addEventListener("state", (e) => {
    const state = e.detail;
    if (!state) return;
    duration = state.duration;
    if (!isDragging) position = state.position;
    isPlaying = !state.paused;
    lastUpdate = Date.now();
    updateUI();
  });
  animate();
  const nextElement = document.querySelector(".next-action");
  nextElement?.addEventListener("click", async () => {
    const state = await window.player?.getCurrentState();
    if (state?.track_window?.next_tracks?.length > 0) {
      window.__navInProgress = true;
      await window.player.nextTrack();
      return;
    }
    const nxt = goNext();
    if (nxt) {
      window.__navInProgress = true;
      await spotifyPlayerAction("play", {
        uris: [nxt.uri],
        deviceId: window.deviceId,
      });
      return;
    }
    try {
      await spotifyPlayerAction("next", { deviceId: window.deviceId });
    } catch (error) {}
  });
</script>
