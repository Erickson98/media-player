---

---

<div id="center-panel">
</div>
<template id="structure-home-view">
  <section id="sections-home">
    <div class="top-view-elements"></div>

    <div class="newRelease"></div>

    <div class="might-like"></div>
    <div class="artist-you-like"></div>
  </section>
