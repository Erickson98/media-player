---
const { album } = Astro.props as { album: any };
---

<div>
  <a href="/" target="_blank" rel="noopener noreferrer">Album</a>
  <div class="container-for-albums-carrusel">
    {
      album.items.map((item) => (
        <div class="container-for-play">
          <button class="btn-album-go-to" data-album-id={item.id}>
            <div>
              <img
                class="img-album"
                src={item?.images?.[1]?.url ?? item?.images?.[0]?.url}
                alt={item?.name}
                width="153"
                fetchpriority="high"
                decoding="sync"
                loading="eager"
              />
              <div class="text-style">
                <div class="album-name">{item?.name}</div>
                <span class="album-artists">
                  {item?.artists?.map((a) => a.name).join(", ")}
                </span>
              </div>
            </div>
          </button>

          <button
            class="btn-hidden playSong-Album-Carrousel"
            data-track-album={item.uri}
            data-track={JSON.stringify({
              id: item.id,
              uri: item.uri,
              name: item.name,
              imgAlbum: item.images,
              artists: item.artists,
            })}
          >
            <img
              src="/play.svg"
              alt="play icon"
              data-state="play"
              class={`btn-hidden-pause-${item.id}`}
            />
          </button>
        </div>
      ))
    }
  </div>
</div>

<style>
  .img-album {
    border-radius: 5px;
  }
  .container-for-albums-carrusel {
    display: flex;
  }
</style>
