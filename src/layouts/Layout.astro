    <div class="grid-layout">
      <header class="header-container">
        <div class="header-side">
          <a href="/" aria-label="app icon" rel="noopener' noreferrer"
            ><img
              src="/icon.webp"
              width="50"
              alt=""
              srcset=""
              class="side"
            /></a
          >
        </div>
        <SearchBar />
        <SocialMedia />
      </header>

      <div class="default-grid-template-columns" id="split-wrapper">
        <aside
          class="panel aside-bar"
          id="left-panel"
          data-overlayscrollbars-initialize
        >
          <slot name="left" />
        </aside>

        <div class="gutter-col gutter-1 gutter-left-row"></div>

        <div class="panel" id="here" style="border-radius: 15px;">
          <main id="center-panel"><slot /></main>
          <Footer />
        </div>

        <div class="gutter-col gutter-3 gutter-right"></div>

        <aside class="panel right-panel" id="right-panel">
          <slot name="right" />
        </aside>
      </div>
      <div class="player">
        <Index />
      </div>
    </div>

    <script src="https://sdk.scdn.co/spotify-player.js"></script>

    <script nonce={Astro.locals.nonce} type="module">
      import { playerEvents } from "/scripts/playerEvents.js";
      import { getSpotifyToken } from "/scripts/getSpotifyToken.js";
      import { pushTrack } from "/scripts/playHistory.js";
      try {
        window.onSpotifyWebPlaybackSDKReady = async () => {
          const player = new Spotify.Player({
            name: "Media dsPlayer",
            getOAuthToken: async (cb) => {
              try {
                const token = await getSpotifyToken();
                cb(token);
              } catch (err) {
                console.error("Error fetching token", err);
              }
            },
            volume: 0.1,
          });
          player.setVolume(0.0).then(() => {
            console.log("Volume updated!");
          });

          window.deviceId = null;

          function savePlaybackSnapshot(state) {
            if (!state || !state.track_window?.current_track) return;
            localStorage.setItem(
              "playbackSnapshot",
              JSON.stringify({
                uri: state.track_window.current_track.uri,
                position: state.position,
                duration: state.duration,
                paused: state.paused,
                savedAt: Date.now(),
              })
            );
          }

          let lastTrackId = null;
          function syncNowPlaying(state) {
            const track = state?.track_window?.current_track;
            if (!track || track.id === lastTrackId) return;
            lastTrackId = track.id;
            const prev =
              JSON.parse(localStorage.getItem("lastPlayedHistory") || "null") ||
              {};
            localStorage.setItem(
              "lastPlayedHistory",
              JSON.stringify({
                ...prev,
                trackId: track.id,
                trackName: track.name,
                imgAlbum: track.album?.images?.[0]?.url || "",
                trackArtists: track.artists,
                artistName: track.artists?.[0]?.name || "",
                albumName: track.album?.name || "",
              })
            );
            window.dispatchEvent(new CustomEvent("route:playing"));

            if (window.__navInProgress) {
              window.__navInProgress = false;
              return;
            }

            pushTrack({
              uri: track.uri,
              id: track.id,
              name: track.name,
              image: track.album?.images?.[0]?.url || "",
              artistName: track.artists?.[0]?.name || "",
              albumName: track.album?.name || "",
            });
          }

          player.addListener("player_state_changed", (state) => {
            playerEvents.dispatchEvent(
              new CustomEvent("state", { detail: state })
            );
            savePlaybackSnapshot(state);
            syncNowPlaying(state);
          });
          async function restorePlayback() {
            let snap = null;
            try {
              snap = JSON.parse(
                localStorage.getItem("playbackSnapshot") || "null"
              );
            } catch (_) {}

            if (!snap?.uri) {
              try {
                const res = await fetch("/api/spotify/me/player");
                if (res.status === 200) {
                  const data = await res.json();
                  if (data?.item) {
                    snap = {
                      uri: data.item.uri,
                      position: data.progress_ms || 0,
                      duration: data.item.duration_ms,
                    };
                  }
                }
              } catch (e) {
                console.error("No se pudo consultar /me/player:", e);
              }
            }

            if (!snap?.uri) return;

            window.__pendingResume = {
              uri: snap.uri,
              position: snap.position || 0,
            };
            playerEvents.dispatchEvent(
              new CustomEvent("state", {
                detail: {
                  duration: snap.duration || 0,
                  position: snap.position || 0,
                  paused: true,
                },
              })
            );
          }

          player.addListener("ready", async ({ device_id }) => {
            window.deviceId = device_id;
            console.log("Player ready with device ID", device_id);
            await restorePlayback();
          });

          player.addListener("initialization_error", ({ message }) => {
            console.error(message);
          });
          player.addListener("authentication_error", ({ message }) => {
            console.error(message);
          });
          player.addListener("account_error", ({ message }) => {
            console.error(message);
          });
          player.addListener("playback_error", ({ message }) => {
            console.error(message);
          });

          player.connect();

          setInterval(async () => {
            const s = await player.getCurrentState();
            if (s && !s.paused) savePlaybackSnapshot(s);
          }, 3000);

          playerEvents.addEventListener("pause", () => player.pause());
          playerEvents.addEventListener("resume", () => player.resume());
          playerEvents.addEventListener("toggle", () => player.togglePlay());
          playerEvents.addEventListener("next", () => player.nextTrack());
          playerEvents.addEventListener("prev", () => player.previousTrack());
          playerEvents.addEventListener("seek", (e) =>
            player.seek(e.detail.position)
          );
          window.player = player;
        };
      } catch (error) {
        console.log(error);
      }
    </script>

    <script type="module" lang="ts"></script>
  </body>
</html>

<script type="module" nonce={Astro.locals.nonce}>
  window.addEventListener("DOMContentLoaded", async () => {
    await import("/scripts/Split.js");
  });
</script>
